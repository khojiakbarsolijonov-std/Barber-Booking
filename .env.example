# Database (PostgreSQL - Neon, Supabase, Railway, or local Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/barber_booking?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="barber-booking-platform-secret-key-32chars"

# Telegram Bot Integration (Optional for local testing, required for bot notifications)
TELEGRAM_BOT_TOKEN=""
BARBER_TELEGRAM_ID=""
TELEGRAM_WEBHOOK_SECRET="telegram-webhook-secret"

# AWS S3 (Optional - for image storage)
AWS_REGION="us-west-2"
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_FOLDER_PREFIX=""
